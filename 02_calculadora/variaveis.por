programa {
  funcao inicio() {
   inteiro numero = 10
   real numeroreal = 10.5
   caracter opcao = 'a'
   logico status = verdadeiro
   cadeia lula = "em setembro vai entrar o GROSSO" 
   

   escreva(numero)
   escreva("\n" + numeroreal)
   escreva("\n" + opcao)
   escreva("\n" + status)
   escreva("\n" + lula)



  }
}
